        "toTable": "fact_orders",
        "toColumn": "order_id"
      },
      {
        "name": "Rel_Reviews_Orders",
        "fromTable": "fact_reviews",
        "fromColumn": "order_id",
        "toTable": "fact_orders",
        "toColumn": "order_id"
      },
      {
        "name": "Rel_Delivery_Orders",
        "fromTable": "fact_delivery",
        "fromColumn": "order_id",
        "toTable": "fact_orders",
        "toColumn": "order_id"
      }
    ]
  }
}