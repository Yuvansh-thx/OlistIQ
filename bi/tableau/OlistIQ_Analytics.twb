<?xml version="1.0" ?>
<workbook xmlns:user="http://www.tableausoftware.com/xml/user" source-build="2024.1.0" source-platform="mac" version="18.1" xml:base="http://www.tableausoftware.com/xml/user">
  <preferences>
    <color-palette name="OlistIQ_Indigo" type="regular">
      <color>#4338CA</color>
      <color>#6366F1</color>
      <color>#10B981</color>
      <color>#F59E0B</color>
      <color>#EF4444</color>
      <color>#3B82F6</color>
      <color>#8B5CF6</color>
      <color>#64748B</color>
    </color-palette>
  </preferences>
  <datasources>
    <datasource caption="Monthly Sales &amp; GMV (OlistIQ)" inline="true" name="federated.monthly_sales" version="18.1">
      <connection class="federated" directory="/Users/shivanshyadav/Desktop/Data Analytics Project/OSlit/data/exports" filename="bi_monthly_sales.csv"/>
      <column caption="Governed GMV (R$)" datatype="real" name="[Calculation_GMV]" role="measure" type="quantitative">
        <calculation class="tableau" formula="SUM([total_gmv])"/>
      </column>
      <column caption="MoM Growth %" datatype="real" name="[Calculation_MoM_Growth]" role="measure" type="quantitative">
        <calculation class="tableau" formula="ZN(([Calculation_GMV] - LOOKUP([Calculation_GMV], -1)) / ABS(LOOKUP([Calculation_GMV], -1))) * 100"/>
      </column>
    </datasource>
  </datasources>
  <worksheets>
    <worksheet name="Executive_GMV_Trend">
