{
  "theme": "Indigo_Modern",
  "dashboards": [
    {
      "id": "looker_page_1",
      "title": "1. Executive Overview Dashboard",
      "dataSource": "Supabase View: bi_executive_overview / bi_monthly_sales",
      "dateControl": {
        "field": "order_purchase_timestamp",
        "defaultRange": "2017-01-01 to 2018-08-31"
      },
      "filters": [
        {
          "name": "Customer State",
          "dimension": "state",
          "controlType": "Drop-down list"
        },
        {
          "name": "Category",
          "dimension": "category_display_name",
          "controlType": "Search box"
        }
      ],
      "scorecards": [
        {
          "title": "Gross Merchandise Value",
          "metric": "SUM(total_gmv)",
          "format": "Currency (BRL)",
          "sparkline": "month_date"
        },
        {
          "title": "Total Orders",
          "metric": "SUM(total_orders)",
          "format": "Number",
          "sparkline": "month_date"
        },
        {
          "title": "Average Order Value",
          "metric": "SUM(total_gmv)/SUM(total_orders)",
          "format": "Currency (BRL)"
        },
        {
          "title": "On-Time Delivery Rate",
          "metric": "SUM(on_time_deliveries)/SUM(total_delivered_orders)",
          "format": "Percent"
        }
      ],
      "charts": [
        {
          "type": "Time Series Line & Area Chart",
          "title": "Monthly GMV & Order Velocity Trend",
          "dimension": "year_month",
          "metrics": [
            "SUM(total_gmv)",
            "SUM(total_orders)"
          ]
        },
        {
          "type": "Donut Chart",
          "title": "Top Categories Revenue Distribution",
          "dimension": "category",
          "metric": "SUM(category_gmv)",
          "sliceCount": 8
        },
        {
          "type": "Geo Map",
          "title": "Brazilian Regional Sales Concentration",
          "dimension": "customer_state",
          "metric": "SUM(total_delivered_orders)",
          "zoomRegion": "BR"
        }
      ]
    },
    {
      "id": "looker_page_2",
      "title": "2. Sales Intelligence Dashboard",
      "dataSource": "Supabase View: bi_monthly_sales",
      "scorecards": [
        {
          "title": "Product Sales (Net)",
          "metric": "SUM(total_product_sales)",
          "format": "Currency (BRL)"
        },
        {
          "title": "Freight Revenue",
          "metric": "SUM(total_freight_revenue)",
          "format": "Currency (BRL)"
        },
        {
          "title": "Units Sold",
          "metric": "SUM(total_units_sold)",
          "format": "Number"
        }
      ],
      "charts": [
        {
          "type": "Stacked Bar Chart",
          "title": "Product Sales vs Freight Revenue by Month",
          "dimension": "year_month",
          "metrics": [
            "SUM(total_product_sales)",
            "SUM(total_freight_revenue)"
          ]
        },
        {
          "type": "Table with Heatmap",
          "title": "Monthly Performance Breakdown",
          "dimension": "year_month",
          "metrics": [
            "total_orders",
            "total_gmv",
            "average_order_value",
            "mom_gmv_growth_pct"
          ]
        }
      ]
    },
    {
      "id": "looker_page_3",
      "title": "3. Customer Intelligence Dashboard",
      "dataSource": "Extract: bi_customer_segments.csv / bi_customer_cohorts.csv",
      "scorecards": [
        {
          "title": "Total Unique Buyers",
          "metric": "COUNT_DISTINCT(customer_unique_id)",
          "format": "Number"
        },
        {
          "title": "Repeat Buyer Rate",
          "metric": "3.06%",
          "format": "Percent"
        },
        {
          "title": "Projected CLV",
          "metric": "R$ 48.74",
          "format": "Currency (BRL)"
        }
      ],
      "charts": [
        {
          "type": "Bar Chart",
          "title": "Customer Count by RFM Segment",
          "dimension": "rfm_segment",
          "metric": "COUNT(customer_unique_id)",
          "sort": "DESC"
        },
        {
          "type": "Pivot Table",
          "title": "Cohort Retention Matrix (% of Initial Month)",
          "rowDimension": "cohort_month",
          "columnDimension": "cohort_index",
          "metric": "AVG(retention_rate)"
        }
      ]
    },
    {
      "id": "looker_page_4",
      "title": "4. Logistics & SLA Intelligence Dashboard",
      "dataSource": "Supabase View: bi_delivery_performance",
      "scorecards": [
        {
          "title": "On-Time Delivery Rate",
          "metric": "91.89%",
          "format": "Percent"
        },
        {
          "title": "Average Delivery Duration",
          "metric": "12.56 Days",
          "format": "Number"
        },
        {
          "title": "Average Days Ahead of SLA",
          "metric": "13.01 Days",
          "format": "Number"
        }
      ],
      "charts": [
        {
          "type": "Horizontal Bar Chart",
          "title": "Average Delivery Days by Customer State",
          "dimension": "customer_state",
          "metric": "AVG(avg_delivery_duration_days)",
          "sort": "ASC"
        },
        {
          "type": "Scatter Plot",
          "title": "Delivery Duration vs Late Breach Rate by Region",
          "xMetric": "avg_delivery_duration_days",
          "yMetric": "100 - on_time_delivery_rate_pct",
          "dimension": "customer_state"
        }
      ]
    },
    {
      "id": "looker_page_5",
      "title": "5. Product & Seller Intelligence Dashboard",
      "dataSource": "Supabase View: bi_category_performance / bi_seller_performance",
      "scorecards": [
        {
          "title": "Active Product Categories",
          "metric": "72",
          "format": "Number"
        },
        {
          "title": "Active Marketplace Sellers",
          "metric": "3,095",
          "format": "Number"
        },
        {
          "title": "Average Selling Price",
          "metric": "R$ 120.65",
          "format": "Currency (BRL)"
        }
      ],
      "charts": [
        {
          "type": "Bar Chart",
          "title": "Top 15 Categories by GMV Contribution",
          "dimension": "category",
          "metric": "SUM(category_gmv)",
          "sort": "DESC"
        },
        {
          "type": "Table with Bars",
          "title": "Top Marketplace Sellers Leaderboard",
          "dimension": "seller_id",
          "metrics": [
            "total_seller_gmv",
            "total_orders",
            "avg_seller_review_score",
            "seller_state"
          ]
        }
      ]
    },
    {
      "id": "looker_page_6",
      "title": "6. Customer Experience & CSAT Dashboard",
      "dataSource": "Supabase View: bi_customer_reviews",
      "scorecards": [
        {
          "title": "Average Review CSAT",
          "metric": "4.09 / 5.0",
          "format": "Rating"
        },
        {
          "title": "Promoter Share (4-5 Stars)",
          "metric": "76.8%",
          "format": "Percent"
        },
        {
          "title": "Detractor Share (1-2 Stars)",
          "metric": "14.7%",
          "format": "Percent"
        }
      ],
      "charts": [
        {
          "type": "Column Chart",
          "title": "Rating Score Distribution (1 to 5 Stars)",
          "dimension": "review_score",
          "metric": "SUM(total_reviews)"
        },
        {
          "type": "Bar Chart",
          "title": "CSAT Drop for On-Time vs Late Deliveries",
          "dimension": "Delivery Status",
          "metric": "Average CSAT",
          "values": [
            {
              "On-Time": 4.22
            },
            {
              "Late": 2.5
            }
          ]
        }
      ]
    }
  ]
}